{{!-- Antora navigation: buttons for expandable category nodes, real links for pages. --}}
<ul class="nav-tree">
{{#each items}}
  <li class="nav-item{{#if items}} nav-parent{{/if}}">
    {{#if items}}
      {{#if url}}
        {{!-- An article with children is a link AND an independently collapsible group. --}}
        <div class="nav-group nav-linked-group">
          <div class="nav-row nav-linked-row">
            <a href="{{{relativize url}}}">{{{content}}}</a>
            <button type="button" class="nav-toggle nav-linked-toggle" aria-expanded="true" aria-label="Toggle subtopics">
              <span class="nav-chevron" aria-hidden="true">▾</span>
            </button>
          </div>
          <div class="nav-children">{{> nav-tree items=items}}</div>
        </div>
      {{else}}
        <div class="nav-group">
          <button type="button" class="nav-row nav-toggle" aria-expanded="true">
            <span class="nav-label">{{{content}}}</span>
            <span class="nav-chevron" aria-hidden="true">▾</span>
          </button>
          <div class="nav-children">
            {{> nav-tree items=items}}
          </div>
        </div>
      {{/if}}
    {{else}}
      <div class="nav-row">
        {{#if url}}<a href="{{{relativize url}}}">{{{content}}}</a>{{else}}<span>{{{content}}}</span>{{/if}}
      </div>
    {{/if}}
  </li>
{{/each}}
</ul>
